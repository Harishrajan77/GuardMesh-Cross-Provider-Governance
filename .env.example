# Provider API Keys (leave blank if not using)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional GuardMesh API Gateway key
GUARDMESH_API_KEY=

# Database Connection (SQLite by default, or PostgreSQL string)
# DATABASE_URL=postgresql://guardmesh_user:guardmesh_secure_password@db:5432/guardmesh_db
DATABASE_URL=sqlite:///./guardmesh.db
POLICY_PATH=configs/policy.yaml
